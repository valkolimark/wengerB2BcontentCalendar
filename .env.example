# Supabase — copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). .env.local is gitignored.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anonymous key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only. NEVER expose to the browser or commit it.
# Used for running migrations/seeds and privileged server tasks.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — server-only. Powers the read-only AI assistant
# (/api/assistant). NEVER a NEXT_PUBLIC_* name; never shipped to the browser.
ANTHROPIC_API_KEY=

# Jira sync (Cycle 14) — powers "Send to Jira" on a campaign. All server-only
# except the base URL. When any of the four below is missing, the button hides
# and CSV export still works. Create a token at
# id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://wengercorp.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=MARCOM
# Optional: override deliverable-owner → Jira accountId mapping (JSON).
# JIRA_ASSIGNEES={"Chris Klett":"712020:...","Adam Bengtson":"712020:...","Tami Roberts":"712020:..."}
# Copy-approval watcher added to every comp (design) issue — Whitney Winkels'
# Jira accountId. Unset = skip watchers silently.
JIRA_WATCHER_COMP=

# Public copy of the Jira base URL — lets the app link created issues. Safe to
# expose (it's just the site URL). Set to the same value as JIRA_BASE_URL.
NEXT_PUBLIC_JIRA_BASE_URL=https://wengercorp.atlassian.net

# Public app URL — used in Jira issue descriptions' "Tracker:" deep link back to
# the campaign. Omit the link when unset (never emit a broken URL).
NEXT_PUBLIC_APP_URL=https://wenger-b2b-content-calendar.vercel.app
