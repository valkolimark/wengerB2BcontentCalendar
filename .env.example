# Supabase — copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). .env.local is gitignored.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anonymous key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only. NEVER expose to the browser or commit it.
# Used for running migrations/seeds and privileged server tasks.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — server-only. Powers the read-only AI assistant
# (/api/assistant). NEVER a NEXT_PUBLIC_* name; never shipped to the browser.
ANTHROPIC_API_KEY=
